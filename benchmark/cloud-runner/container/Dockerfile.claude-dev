# =============================================================================
# Claude Code Development Container for Cloud Integration Tests
# =============================================================================
#
# This Dockerfile creates an environment for developing cloud integration tests
# with Claude Code in --dangerously-skip-permissions mode.
#
# Key design decisions:
# - SSH keys are generated by infra setup, stored in /output/ssh (not ~/.ssh)
# - Cloud credentials (AWS, GCP, Azure) are bind-mounted at runtime
# - Claude Code is installed via npm for --dangerously-skip-permissions support
#
# Build:
#   docker build -t claude-cloud-dev -f Dockerfile.claude-dev .
#
# Run (with credentials mounted):
#   docker run -it --rm \
#     -v ~/.aws:/root/.aws:ro \
#     -v ~/.config/gcloud:/credentials/gcloud:ro \
#     -v ~/.azure:/credentials/azure:ro \
#     -v $(pwd)/output:/output \
#     -v /path/to/iceberg:/workspace \
#     -e ANTHROPIC_API_KEY="$ANTHROPIC_API_KEY" \
#     claude-cloud-dev
#
# =============================================================================

FROM ubuntu:22.04

LABEL maintainer="Apache Iceberg"
LABEL description="Claude Code development environment for cloud integration tests"

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# =============================================================================
# Base Dependencies
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core utilities
    ca-certificates \
    curl \
    gnupg \
    lsb-release \
    unzip \
    wget \
    # SSH for VM access (keys come from /output/ssh, not ~/.ssh)
    openssh-client \
    # JSON/YAML processing
    jq \
    # Development tools
    git \
    vim \
    less \
    # Python for scripts
    python3 \
    python3-pip \
    # Build essentials (for native node modules if needed)
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Node.js 20.x LTS (required for Claude Code)
# =============================================================================
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version && npm --version

# =============================================================================
# Claude Code CLI
# =============================================================================
RUN npm install -g @anthropic-ai/claude-code \
    && claude --version

# =============================================================================
# AWS CLI v2
# =============================================================================
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/aws /tmp/awscliv2.zip \
    && aws --version

# =============================================================================
# Google Cloud SDK
# =============================================================================
RUN echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
    | tee /etc/apt/sources.list.d/google-cloud-sdk.list \
    && curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
    | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-cloud-cli \
    && rm -rf /var/lib/apt/lists/* \
    && gcloud version

# =============================================================================
# Azure CLI
# =============================================================================
RUN curl -fsSL https://aka.ms/InstallAzureCLIDeb | bash \
    && az version

# =============================================================================
# yq (YAML processor)
# =============================================================================
RUN curl -fsSL "https://github.com/mikefarah/yq/releases/download/v4.40.5/yq_linux_amd64" \
    -o /usr/local/bin/yq \
    && chmod +x /usr/local/bin/yq

# =============================================================================
# Java 17 (for Gradle/JMH benchmarks)
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/* \
    && java --version

# =============================================================================
# Create Non-Root User
# =============================================================================
# Claude Code refuses --dangerously-skip-permissions as root for security.
# Create a 'claude' user with matching UID/GID to host user (default 1000).

ARG USER_UID=1000
ARG USER_GID=1000

RUN groupadd --gid $USER_GID claude \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash claude \
    && mkdir -p /home/claude/.config /home/claude/.claude /home/claude/.ssh \
    && chown -R claude:claude /home/claude

# =============================================================================
# Directory Structure
# =============================================================================
# /workspace  - Iceberg source code (bind mount)
# /output     - Generated files, SSH keys, logs (bind mount, read-write)
# /credentials - Cloud credentials (bind mounts, read-only)
#   /credentials/aws     -> ~/.aws
#   /credentials/gcloud  -> ~/.config/gcloud
#   /credentials/azure   -> ~/.azure
# /home/claude/.claude - Claude Code OAuth config (bind mount from ~/.claude)

RUN mkdir -p /workspace /output /credentials/aws /credentials/gcloud /credentials/azure \
    && chown -R claude:claude /workspace /output /credentials

# =============================================================================
# Credential Symlinks
# =============================================================================
# AWS CLI reads from ~/.aws by default
# GCP SDK reads from ~/.config/gcloud by default
# Azure CLI reads from ~/.azure by default
#
# We symlink from the bind mount locations so credentials work transparently.
# Note: GCP/Azure may need writable config dirs for caching, handled by entrypoint.

RUN ln -sf /credentials/aws /home/claude/.aws \
    && chown -h claude:claude /home/claude/.aws

# =============================================================================
# SSH Configuration
# =============================================================================
# SSH keys are generated by infrastructure setup and stored in /output/ssh
# NOT mounted from host ~/.ssh
#
# Configure SSH to use keys from /output/ssh and disable strict host checking
# for newly provisioned VMs

RUN chmod 700 /home/claude/.ssh \
    && cat > /home/claude/.ssh/config << 'EOF'
# Cloud benchmark SSH configuration
# Keys are stored in /output/ssh, generated by infra setup

Host *
    StrictHostKeyChecking accept-new
    UserKnownHostsFile /output/ssh/known_hosts
    IdentityFile /output/ssh/iceberg-benchmark.pem
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
EOF
RUN chown -R claude:claude /home/claude/.ssh

# =============================================================================
# Environment Variables
# =============================================================================
ENV WORKSPACE_DIR=/workspace
ENV OUTPUT_DIR=/output
ENV SSH_KEY_PATH=/output/ssh/iceberg-benchmark.pem
ENV HOME=/home/claude
ENV TERM=xterm-256color

# Claude Code configuration
ENV CLAUDE_CODE_SKIP_PERMISSIONS_CHECK=1

# =============================================================================
# Entrypoint Script
# =============================================================================
# Handles:
# - Copying GCP/Azure credentials to writable locations if needed
# - Setting up SSH key permissions
# - Starting Claude Code or bash shell

RUN cat > /entrypoint.sh << 'ENTRYPOINT'
#!/bin/bash
set -e

# -----------------------------------------------------------------------------
# GCP Credentials Setup
# -----------------------------------------------------------------------------
# GCP SDK writes to ~/.config/gcloud (logs, credentials.db)
# If host credentials are mounted read-only, copy to writable location

if [[ -d /credentials/gcloud && -n "$(ls -A /credentials/gcloud 2>/dev/null)" ]]; then
    if [[ ! -w /credentials/gcloud ]]; then
        echo "[setup] Copying GCP credentials to writable location..."
        mkdir -p "$HOME/.config/gcloud"
        cp -a /credentials/gcloud/* "$HOME/.config/gcloud/" 2>/dev/null || true
    else
        # Credentials are writable, just symlink
        ln -sf /credentials/gcloud "$HOME/.config/gcloud" 2>/dev/null || true
    fi
else
    mkdir -p "$HOME/.config/gcloud"
fi

# -----------------------------------------------------------------------------
# Azure Credentials Setup
# -----------------------------------------------------------------------------
# Azure CLI writes to ~/.azure (token cache)
# If host credentials are mounted read-only, copy to writable location

if [[ -d /credentials/azure && -n "$(ls -A /credentials/azure 2>/dev/null)" ]]; then
    if [[ ! -w /credentials/azure ]]; then
        echo "[setup] Copying Azure credentials to writable location..."
        mkdir -p "$HOME/.azure"
        cp -a /credentials/azure/* "$HOME/.azure/" 2>/dev/null || true
    else
        ln -sf /credentials/azure "$HOME/.azure" 2>/dev/null || true
    fi
else
    mkdir -p "$HOME/.azure"
fi

# -----------------------------------------------------------------------------
# SSH Key Permissions
# -----------------------------------------------------------------------------
# Ensure SSH keys have correct permissions (required by OpenSSH)

if [[ -d /output/ssh ]]; then
    chmod 700 /output/ssh 2>/dev/null || true
    chmod 600 /output/ssh/*.pem 2>/dev/null || true
    chmod 600 /output/ssh/id_* 2>/dev/null || true
fi

# -----------------------------------------------------------------------------
# Verify Environment (optional debug info)
# -----------------------------------------------------------------------------
if [[ "${DEBUG:-}" == "1" ]]; then
    echo "[debug] Environment check:"
    echo "  - AWS CLI: $(aws --version 2>/dev/null || echo 'not configured')"
    echo "  - GCP SDK: $(gcloud --version 2>/dev/null | head -1 || echo 'not configured')"
    echo "  - Azure CLI: $(az version 2>/dev/null | jq -r '."azure-cli"' || echo 'not configured')"
    echo "  - Claude Code: $(claude --version 2>/dev/null || echo 'not found')"
    echo "  - SSH key: $(ls -la /output/ssh/*.pem 2>/dev/null || echo 'not generated')"
fi

# -----------------------------------------------------------------------------
# Execute Command
# -----------------------------------------------------------------------------
cd /workspace
exec "$@"
ENTRYPOINT

RUN chmod +x /entrypoint.sh

# =============================================================================
# Working Directory
# =============================================================================
WORKDIR /workspace

# Switch to non-root user
USER claude

ENTRYPOINT ["/entrypoint.sh"]
CMD ["claude", "--dangerously-skip-permissions"]
